    {
      "name": "leetcode_search_problems",
      "description": "Search the complete locally synchronized catalog by problem number, title, or slug without network access.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "filters": {
            "default": {
              "paid": "all",
              "favorite": false
            },
            "type": "object",
            "properties": {
              "difficulties": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "Easy",
                    "Medium",
                    "Hard"
                  ]
                }
              },
              "categories": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "algorithms",
                    "database",
                    "shell",
                    "concurrency"
                  ]
                }
              },
              "paid": {
                "default": "all",
                "type": "string",
                "enum": [
                  "all",
                  "free",
                  "paid"
                ]
              },
              "statuses": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "solved",
                    "attempted",
                    "not_started"
                  ]
                }
              },
              "favorite": {
                "default": false,
                "type": "boolean"
              }
            }
          },
          "limit": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "leetcode_get_problem",
      "description": "Fetch one selected problem's current statement, samples, tags, metadata, and templates from LeetCode. The detail is not cached locally.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "problemId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "problemId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
