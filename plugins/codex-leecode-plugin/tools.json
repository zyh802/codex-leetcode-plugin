      "inputSchema": {
        "type": "object",
        "properties": {
          "problemId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "langSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "problemId",
          "langSlug",
          "directory"
