{
  "name": "codex-leecode-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first LeetCode catalog, judge, and review plugin for Codex.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:ui",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "lint:boundaries": "node scripts/check-ui-boundaries.mjs",
    "check:bundle": "node scripts/check-ui-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "smoke:mcp": "npm run build && node scripts/mcp-smoke.mjs",
    "build:marketplace": "npm run build && node scripts/build-marketplace.mjs",
    "check:marketplace": "npm run build && node scripts/build-marketplace.mjs --check",
    "smoke:marketplace": "node scripts/marketplace-smoke.mjs",
    "check": "npm run lint:boundaries && npm run typecheck && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "eventemitter3": "^5.0.4",
    "lucide-react": "^1.25.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "proper-lockfile": "^4.1.2",
    "tar": "^7.5.22",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
